groups:

- name: network_icmp_alerts
  rules:
  - alert: NetworkHostUnreachable
    expr: probe_success{job="network_icmp"} == 0
    for: 2m
    labels:
    severity: warning
    annotations:
    summary: "ICMP probe failing for {{ $labels.instance }}"
    description: "The target {{ $labels.instance }} has failed ICMP probes for at least 2 minutes."
